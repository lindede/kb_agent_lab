# Compatible OpenAI-style API (also works with many China gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local paths
CHROMA_DIR=./data/chroma
DOCS_DIR=./docs
CHROMA_COLLECTION=kb_agent_lab

# Chunking / retrieve
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_K=4
