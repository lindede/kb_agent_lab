# Compatible OpenAI-style API (also works with many China gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=kimi-k2.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=1

# ask: agent (LangGraph+tools) | rag (classic retrieve+LLM)
ASK_MODE=agent
AGENT_MAX_ITERATIONS=4

# Embedding: local (default, no remote /embeddings) | openai
EMBEDDING_PROVIDER=local

# Local paths
CHROMA_DIR=./data/chroma
DOCS_DIR=./docs
NOTES_DIR=./data/notes
CHROMA_COLLECTION=kb_agent_lab

# Chunking / retrieve
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_K=4
